## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
# Repo PM3 debug tooling (exception to [Dd]ebug/ — not MSBuild output)
!debug/
!debug/**
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Custom dev environment files
*.devenv*

# Data dumps
dumps/*

# RidesCli unknown-family dumps written to the repo root
elevator-t55xx-*.bin

# LF tune probe output (see debug/plot-lf-tune-probe.py)
debug/lf-tune-probes/*
!debug/lf-tune-probes/.gitkeep

# Ephemeral hardware capture logs under tag-backups
debug/tag-backups/*/

# Experimental native fixtures (regenerate via debug probes)
Pm3UsbApi.Tests/Fixtures/Native/psk1-block0-samples.bin
# User-specific and idea/vscode files
.idea/*
.vscode/*
*.DotSettings.user

# Proxmark3 run output (dump files, etc.) - process runs with WorkingDirectory here
proxmark-runs/

# Ride capture tool generated config/data
ride-capture-config.json
ride-capture-data/
